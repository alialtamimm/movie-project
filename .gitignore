## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
 
# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
 
# Visual Studio files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
 
# Build log
*.log
 
# NuGet
**/packages/*
*.nupkg
**/[Pp]ackages/
 
# OS files
.DS_Store
Thumbs.db
 
# Rider
.idea/
 
# dotnet stuff
project.lock.json
*.nuget.props
*.nuget.targets