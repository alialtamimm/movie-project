<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema System</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <nav class="navbar">
        <a href="/" class="nav-brand">Cinema Booking</a>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/Films">Films</a>
            @if (Context.Session.GetString("CustomerEmail") != null)
            {
                <a href="/MyTickets">My Tickets</a>
                <a href="/Account">Account</a>
                <a href="/Logout">Logout</a>
            }
            else
            {
                <a href="/Login">Login</a>
                <a href="/Register">Register</a>
            }
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>

    <footer>
        <p>Cinema Film Booking & Membership System - CST2550</p>
    </footer>
</body>
</html>
