@page
@model CinemaSystem.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="hero">
    <h1>Welcome to MiddleMa</h1>
    <p>Book your favourite films online with exclusive member discounts</p>
    <a href="/Films" class="btn">Browse Films</a>
</div>

<div class="feature-grid">
    <div class="feature-card">
        <h3>🎬 Latest Releases</h3>
        <p>Catch the newest blockbusters as soon as they hit the big screen</p>
    </div>
    <div class="feature-card">
        <h3>💎 Member Benefits</h3>
        <p>Join as Premium or VIP and get up to 20% off every ticket</p>
    </div>
    <div class="feature-card">
        <h3>🎟️ Easy Booking</h3>
        <p>Pick your seat and pay securely in just a few clicks</p>
    </div>
</div>