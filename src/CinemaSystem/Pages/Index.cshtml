@page
@model CinemaSystem.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="hero">
    <h1>Welcome to Cinema Booking</h1>
    <p>Book your favourite films online with exclusive member discounts</p>
    <a href="/Films" class="btn">Browse Films</a>
</div>

<div class="film-grid">
    <div class="film-card" style="padding: 30px; text-align: center;">
        <h3>🎬 Latest Releases</h3>
        <p style="margin-top: 15px;">Catch the newest blockbusters as soon as they hit the big screen</p>
    </div>
    <div class="film-card" style="padding: 30px; text-align: center;">
        <h3>💎 Member Benefits</h3>
        <p style="margin-top: 15px;">Join as Premium or VIP and get up to 20% off every ticket</p>
    </div>
    <div class="film-card" style="padding: 30px; text-align: center;">
        <h3>🎟️ Easy Booking</h3>
        <p style="margin-top: 15px;">Pick your seat and pay securely in just a few clicks</p>
    </div>
</div>